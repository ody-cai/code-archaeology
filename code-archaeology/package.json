{
  "name": "code-archaeology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "代码考古学 —— 从提交历史重建代码的决策史。先做信噪分离，再由多模型协作还原人类决策痕迹。",
  "bin": {
    "ca": "./bin/ca.mjs"
  },
  "scripts": {
    "dev": "node scripts/local-server.mjs 8787",
    "deploy": "wrangler deploy",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/build-pages.mjs && wrangler pages deploy pages-dist --project-name=code-archaeology --branch=main --commit-dirty=true",
    "cli": "node bin/ca.mjs",
    "capabilities": "node bin/ca.mjs capabilities",
    "scout": "node scripts/scout.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/smoke-render.mjs chalk/chalk 30",
    "test:miner": "node scripts/test-miner.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=18"
  }
}
