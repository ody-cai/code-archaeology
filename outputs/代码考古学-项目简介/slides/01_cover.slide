                <line x1='0' y1='342' x2='430' y2='342' stroke='#10141A' strokeWidth='2' />

                {/* 沉积层里的自动化噪音刻痕 */}
                <rect x='58' y='14' width='52' height='4' fill='#3A4553' />
                <rect x='196' y='50' width='88' height='5' fill='#3A4553' />
                <rect x='92' y='92' width='40' height='4' fill='#3A4553' />
                <rect x='300' y='182' width='64' height='4' fill='#3A4553' />
