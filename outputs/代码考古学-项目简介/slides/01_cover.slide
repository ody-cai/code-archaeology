<Slide style={{ width: '1280px', height: '720px', padding: 0, position: 'relative', background: 'linear-gradient(160deg, #10141A 0%, #18202A 100%)', fontFamily: "'PingFang SC','Microsoft YaHei','Helvetica Neue',sans-serif" }}>

    {/* 01 · 封面 —— 全幅自定义版式（hero）：琥珀光晕 + 青铜绿光晕，不占安全区 */}
    <Box style={{ position: 'absolute', top: -190, right: -150, width: 580, height: 580, borderRadius: 290, background: 'radial-gradient(circle, rgba(227,163,62,0.16) 0%, rgba(227,163,62,0) 70%)' }} />
    <Box style={{ position: 'absolute', bottom: -220, left: -140, width: 540, height: 540, borderRadius: 270, background: 'radial-gradient(circle, rgba(76,184,166,0.12) 0%, rgba(76,184,166,0) 70%)' }} />

    {/* 内容层：左文右图 · 非对称双栏 */}
    <Box style={{ position: 'relative', zIndex: 1, flexDirection: 'row', width: '1280px', height: '720px', padding: '56px 60px', alignItems: 'center', gap: 48 }}>

        {/* 左栏 · 文字 */}
        <Box style={{ width: 682, height: 608, justifyContent: 'center' }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', letterSpacing: 5, color: '#E3A33E' }}>
                CODE ARCHAEOLOGY
            </Text>

            <Text style={{ fontSize: 84, fontWeight: 'bold', lineHeight: 1.1, color: '#EDF1F5', letterSpacing: 4, marginTop: 18, fontFamily: "'Source Han Serif SC','Noto Serif SC','Songti SC',serif" }}>
                代码考古学
            </Text>

            <Text style={{ fontSize: 24, color: '#8892A0', letterSpacing: 2, marginTop: 12, fontFamily: "'Source Han Serif SC','Noto Serif SC','Songti SC',serif" }}>
                Reconstructing a codebase's decision history
            </Text>

            <Box style={{ width: 96, height: 3, background: '#E3A33E', marginTop: 28 }} />

            <Text style={{ fontSize: 23, lineHeight: 1.55, color: '#EDF1F5', marginTop: 26 }}>
                我们不告诉你「为什么」，
                <br />
                只告诉你<span style={{ color: '#E3A33E', fontWeight: 'bold' }}>「哪里已经没人能说清为什么」</span>。
            </Text>

            <Text style={{ fontSize: 16, lineHeight: 1.5, color: '#8892A0', marginTop: 14 }}>
                We don't tell you why — we tell you where nobody can explain why anymore.
            </Text>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, marginTop: 40 }}>
                <Box style={{ width: 34, height: 2, background: '#4CB8A6' }} />
                <Text style={{ fontSize: 16, color: '#EDF1F5', letterSpacing: 1 }}>
                    BAYTECH 2026 · AI 应用与工程赛道
                </Text>
                <Text style={{ fontSize: 16, color: '#8892A0' }}>
                    ｜ 蔡奇均 / Cai Qijun
                </Text>
            </Box>
        </Box>

        {/* 右栏 · L1 主视觉：地层剖面 */}
        <Box style={{ width: 430, height: 608, justifyContent: 'center' }}>
            <svg width={430} height={380} viewBox='0 0 430 380'>
